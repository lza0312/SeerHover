<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SeerHover</AssemblyName>
    <RootNamespace>SeerHover</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 版本号可由 tools/build.ps1 -Version 或 CI 的 -p:SeerHoverVersion= 注入，缺省 1.0.0 -->
    <SeerHoverVersion Condition="'$(SeerHoverVersion)' == ''">1.0.0</SeerHoverVersion>
    <Version>$(SeerHoverVersion)</Version>
    <AssemblyVersion>$(SeerHoverVersion).0</AssemblyVersion>
    <FileVersion>$(SeerHoverVersion).0</FileVersion>
    <Company>SeerHover</Company>
    <Product>Seer 悬停预览</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

</Project>
